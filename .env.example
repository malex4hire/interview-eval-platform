# Copy to .env and adjust. Every value below has a working default except
# JWT_SECRET, which MUST be replaced outside local development.

ENVIRONMENT=development

# SQLite for the demo; PostgreSQL for anything else.
DATABASE_URL=sqlite:///./interview_platform.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/interviews

JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=480

# PBKDF2 work factor. Raise over time; never lower it in a real deployment.
# The test suite overrides this to 1000 so a full run takes seconds — the
# count is stored inside each hash, so changing it never invalidates one.
PBKDF2_ITERATIONS=480000

# THE knob: an evaluation with confidence strictly below this is routed to
# requires_human_review instead of standing as the outcome.
CONFIDENCE_THRESHOLD=70

# Provider selection. "mock" is deterministic and offline.
LLM_PROVIDER=mock
LLM_MODEL_NAME=mock-eval-v1

COST_PER_1K_INPUT_TOKENS_USD=0.003
COST_PER_1K_OUTPUT_TOKENS_USD=0.015

MAX_AUDIO_BYTES=26214400
